#!/bin/sh /etc/rc.common
# 为 Home Assistant 的米家集成提供 mDNS 别名：
# 小米 OAuth 白名单只认 http://homeassistant.local:8123，本机 mDNS 名是 iStoreOS.local，
# 所以在这里额外发布一个 homeassistant.local -> 192.168.31.2 的 A 记录。
USE_PROCD=1
START=95
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/avahi-publish -a -R homeassistant.local 192.168.31.2
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
